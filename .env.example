# Shared Spring Boot backend
DASHSCOPE_API_KEY=your-dashscope-key
SUPABASE_DB_PASSWORD=your-supabase-password
GITHUB_MCP_PAT=your-readonly-github-token

# EnterpriseRAG (no production defaults are required for startup)
ENTERPRISE_RAG_ENABLED=true
# HTTP admin guard is a canary limit, not the final corpus size.
ENTERPRISE_RAG_MAX_DOCUMENTS=1000
ENTERPRISE_RAG_VECTOR_BACKEND=PGVECTOR
ENTERPRISE_RAG_ACTIVE_CORPUS_ID=
ENTERPRISE_RAG_EMBEDDING_MODEL=text-embedding-v3
ENTERPRISE_RAG_EMBEDDING_DIMENSIONS=1024
ENTERPRISE_RAG_WORKER_BATCH_SIZE=10
ENTERPRISE_RAG_WORKER_CONCURRENCY=1
ENTERPRISE_RAG_MAX_RETRIES=5
ENTERPRISE_RAG_VECTOR_TOP_K=12
ENTERPRISE_RAG_KEYWORD_TOP_K=12
ENTERPRISE_RAG_FINAL_TOP_K=5
ENTERPRISE_RAG_RRF_K=60
ENTERPRISE_RAG_STRATEGY=HYBRID
ENTERPRISE_RAG_RERANK_ENABLED=true
ENTERPRISE_RAG_ADMIN_TOKEN=generate-a-separate-ingestion-token
MAX_EMBEDDING_COST_CNY=
ENTERPRISE_DATABASE_URL=

# Independent EnterpriseRAG Vercel frontend
VITE_API_BASE_URL=https://your-shared-backend.example.com
VITE_ENTERPRISE_RAG_LIVE_URL=https://your-enterprise-rag.vercel.app
